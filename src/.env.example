# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ---------------------------------------------------------------------------
# AI briefing layer — primary configuration (OpenAI-compatible)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint works: OpenAI, Groq, Ollama, llama.cpp, vLLM, …
#
# Examples:
#   OpenAI:        LLM_BASE_URL=https://api.openai.com/v1  LLM_API_KEY=sk-...
#   Ollama local:  LLM_BASE_URL=http://localhost:11434/v1   (no key needed)
#   llama.cpp:     LLM_BASE_URL=http://localhost:8080/v1    (no key needed)
#   Groq:          LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=gsk_...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3

# Provider selection: "openai" | "watsonx" | "mock"
# Defaults automatically:
#   → "openai"   when LLM_BASE_URL or LLM_API_KEY is set
#   → "watsonx"  when WATSONX_API_KEY is set (and no LLM_* vars)
#   → "mock"     when nothing is configured (safe for CI/offline)
GRIDGUARD_LLM_PROVIDER=openai

# Generation parameters (low temperature = more factual / deterministic output)
GRIDGUARD_LLM_MAX_TOKENS=512
GRIDGUARD_LLM_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# AI briefing layer — optional: IBM watsonx.ai credentials
# ---------------------------------------------------------------------------
# Only needed if GRIDGUARD_LLM_PROVIDER=watsonx
# GridGuard does not require watsonx to run.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_PORT=8000
APP_ENV=development

# Database (if used)
DATABASE_URL=sqlite:///gridguard.db

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
